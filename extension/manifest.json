{
  "manifest_version": 3,
  "name": "Full Page Capture",
  "version": "0.6.0",
  "description": "Capture a full-page screenshot of the current tab and auto-download it as a PNG.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Capture full page screenshot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "downloads", "offscreen", "storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Capture a full-page screenshot of the current tab"
    }
  }
}
